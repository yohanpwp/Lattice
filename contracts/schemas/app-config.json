{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lattice.dev/schemas/app-config.json",
  "title": "AppConfig",
  "description": "Public, non-secret configuration served by GET /v1/config. Never add secrets here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tenant_id",
    "backend_url",
    "realtime_url",
    "app_key",
    "schema_version",
    "min_client_version",
    "features",
    "collections"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1, "description": "Version of this config format." },
    "tenant_id": { "type": "string", "minLength": 1 },
    "backend_url": { "type": "string", "format": "uri", "pattern": "^https?://[^/\\s?#]+(?:/[^\\s?#]*)?$", "description": "Stable tenant hostname, never an instance address." },
    "realtime_url": { "type": "string", "format": "uri", "pattern": "^https?://[^/\\s?#]+(?:/[^\\s?#]*)?$", "description": "PocketBase realtime (SSE) endpoint." },
    "app_key": { "type": "string", "minLength": 1, "description": "Publishable key. Not a secret." },
    "schema_version": { "type": "string", "minLength": 1 },
    "min_client_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Oldest client version this backend supports." },
    "features": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "collections": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
