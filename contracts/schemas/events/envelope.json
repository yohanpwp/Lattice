{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lattice.dev/schemas/events/envelope.json",
  "title": "EventEnvelope",
  "description": "Envelope for every event/webhook payload. Always versioned.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "occurred_at", "tenant_id", "data"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "Unique event id (use as idempotency key)." },
    "type": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)+$", "description": "e.g. payment.succeeded" },
    "version": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time", "description": "RFC 3339 timestamp." },
    "tenant_id": { "type": "string", "minLength": 1 },
    "data": { "type": "object", "additionalProperties": true }
  }
}
