{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YourProduct",
  "version": "0.1.0",
  "identifier": "com.yourcompany.yourproduct",
  "build": {
    "beforeDevCommand": "pnpm --filter @yourproduct/client dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @yourproduct/client build",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YourProduct",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.app.example.com http://localhost:* http://127.0.0.1:*",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
